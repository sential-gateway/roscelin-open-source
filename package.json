{
  "name": "roscelin",
  "version": "0.1.0",
  "private": true,
  "description": "Your software, your interface. A Chrome extension that builds checked, approval-gated workspaces from an app's real capabilities.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/",
    "fixture": "node scripts/serve-fixture.mjs",
    "check": "node scripts/build.mjs && node --test tests/",
    "test:a11y": "node scripts/e2e-accessibility.mjs",
    "test:panel": "node scripts/build.mjs --e2e && node scripts/e2e.mjs",
    "test:live": "node scripts/vikunja/instance.mjs reset && node --test --test-concurrency=1 tests-live/",
    "test:free": "npm run check && npm run test:a11y && npm run test:panel"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
